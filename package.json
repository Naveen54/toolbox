{
  "name": "toolbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:analyze": "npm-run-all --parallel dev serve:analyzer",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:wasm": "node build-wasm.js",
    "build:analyze": "cross-env ANALYZE=true tsc -b && vite build && npm run serve:analyzer",
    "analyze": "cross-env ANALYZE=true vite build && http-server dist -p 8888 -o stats.html",
    "serve:analyzer": "cross-env ANALYZE=true vite build && http-server dist -p 8888 -o stats.html",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "async": "^3.2.6",
    "crypto-js": "^4.2.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-aria-components": "^1.5.0",
    "react-dom": "^18.3.1",
    "react-json-view": "^1.21.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.83.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/async": "^3.2.24",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-bundle-visualizer": "^1.2.1"
  }
}
